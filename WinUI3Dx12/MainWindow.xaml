<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WinUI3Dx12.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUI3Dx12"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="WinUI3Dx12"
    mc:Ignorable="d">

    <Grid Loaded="Grid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Keep width and height of the SwapChainPanel fixed to prevent resizing issues with DirectX 12 rendering  -->
        <SwapChainPanel
            x:Name="MainWindowSwapChainPanel"
            Grid.Row="1"
            Width="1000"
            Height="1000" />
        <TextBlock
            Grid.Row="1"
            Margin="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            FontSize="24"
            Text="Hello, WinUI 3 with DirectX 12!" />
    </Grid>
</Window>
